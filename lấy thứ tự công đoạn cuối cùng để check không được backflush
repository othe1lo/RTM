select * from (select  
t1.Company
,t2.Plant
,t2.JobNum
,t1.AssemblySeq
,t1.OprSeq	
,t1.OpCode	
,t1.LaborEntryMethod
,  ROW_NUMBER() OVER (
            PARTITION BY t1.JobNum, t1.AssemblySeq 
            ORDER BY t1.OprSeq DESC
        ) AS RowNum
from erp.JobOper t1 
 inner join erp.jobhead t2 on t1.JobNum = t2.JobNum and t2.Plant ='ktc' --and t1.LaborEntryMethod ='B'
where t2.JobClosed = 0
) x
where x.RowNum = 1
